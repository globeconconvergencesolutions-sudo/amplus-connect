# Copy to the Node app root as `.env` (same folder as package.json).
# DirectAdmin → Setup Node.js App → Environment Variables can set the same keys instead.
# Never commit the filled file. Never put secrets in VITE_* names except public contact/bank.

NODE_ENV=production
HOST=127.0.0.1
# PORT is usually injected by DirectAdmin. Set it only if the panel does not.
# PORT=3000

PUBLIC_APP_URL=https://amplusconstructionsolutions.com

# --- Supabase (required) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Public company (baked into the client at `npm run build`) ---
# Change these BEFORE building. Restarting Node alone will not update the storefront.
VITE_COMPANY_PHONE=+254 700 000 000
VITE_COMPANY_EMAIL=hello@amplusconstructionsolutions.com
VITE_COMPANY_ADDRESS=Amplus House, Mombasa Road, Nairobi, Kenya
VITE_COMPANY_HOURS=Mon – Fri, 8:00 – 17:30 · Sat, 8:00 – 13:00
VITE_COMPANY_MAP_QUERY=Mombasa Road, Nairobi, Kenya
VITE_COMPANY_WHATSAPP=
VITE_BANK_ACCOUNT_NAME=Amplus Construction Solutions Ltd
VITE_BANK_NAME=Equity Bank
VITE_BANK_ACCOUNT_NUMBER=1080287515296
VITE_BANK_PAYBILL=247247

# --- Payments (leave blank until the client pays for live keys) ---
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_ENVIRONMENT=sandbox
PESAPAL_IPN_ID=
PAYSTACK_SECRET_KEY=
VITE_PAYSTACK_PUBLIC_KEY=

# --- Gmail SMTP (Host Africa mailbox can be the From if you prefer their SMTP later) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=Amplus Construction Solutions
ORDER_NOTIFY_EMAIL=

# --- Unpaid-order reminder cron (DirectAdmin Cron Jobs) ---
CRON_SECRET=
