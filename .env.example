# REQUIRED — server-only, never exposed to the browser. Used by checkout,
# payment reconciliation, the Pesapal IPN webhook, and admin role management.
# Get it from Supabase Dashboard -> Project Settings -> API -> service_role key.
SUPABASE_SERVICE_ROLE_KEY=""

# REQUIRED for real payments — Pesapal API 3.0 credentials.
# Get them from the Pesapal merchant dashboard (sandbox: https://developer.pesapal.com).
# Without these, checkout still creates the order but skips payment (shows a
# "payments are not connected yet" message instead of redirecting to Pesapal).
PESAPAL_CONSUMER_KEY=""
PESAPAL_CONSUMER_SECRET=""
# "sandbox" (default) or "live"
PESAPAL_ENVIRONMENT="sandbox"
# Optional: set once Pesapal gives you a persistent IPN id, to skip re-registering
# the notification URL on every order.
PESAPAL_IPN_ID=""

# Paystack — used for the checkout PoC when set. Secret is server-only.
# Public key must be VITE_ so Vite/TanStack Start can expose it to the browser.
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY is accepted as a server-side alias (Next.js name).
PAYSTACK_SECRET_KEY=""
VITE_PAYSTACK_PUBLIC_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# Optional — Gmail SMTP for paid receipts, 24h unpaid-order reminders, and staff invites.
# Use a Google App Password (not the normal account password).
# Staff invites never use Supabase Auth email — they require Gmail or Resend.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
GMAIL_FROM_NAME="Amplus Construction Solutions"
# Used by the reminder cron so links point at the live site.
# Local: http://localhost:8080
# Host Africa: https://amplusconstructionsolutions.com
PUBLIC_APP_URL="http://localhost:8080"

# Optional — Postgres URI to apply SQL from the CLI (support tickets, etc.).
# Dashboard → Project Settings → Database → Connection string (URI).
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Optional — paid-order emails via Resend (https://resend.com).
# Without these, payments still work; customers just won't get a receipt email.
RESEND_API_KEY=""
# Must be a sender you verified in Resend, e.g. Amplus <orders@amplusconstructionsolutions.com>
RESEND_FROM=""
# Staff copy of paid-order notices
ORDER_NOTIFY_EMAIL=""
# Staff inbox for product interest leads (falls back to ORDER_NOTIFY_EMAIL, then VITE_COMPANY_EMAIL)
INTEREST_NOTIFY_EMAIL=""

# Optional — only needed once a scheduled/cron route calls authenticateCronRequest().
# Bearer token the caller must present. Rotate by moving the old value to
# CRON_SECRET_PREVIOUS while CRON_SECRET takes the new one, then drop it later.
CRON_SECRET=""
CRON_SECRET_PREVIOUS=""
